{
    "name": "pi-lsp",
    "title": "Pi Fana Tooling",
    "description": "Owner-gated LSP, AST and CodeGraph queries with verified proposal/apply, post-edit diagnostics and one cached Tooling panel. Preserves 54 LSP definitions and native Pocket features; no automatic installs or indexing.",
    "tags": ["coding","lsp","ast","codegraph","refactoring","developer"],
    "author": {
        "name": "MasFana",
        "github": "MasFana"
    },
    "version": "1.3.0",
    "pocketApi": 2,
    "minPocket": "0.28.0",
    "source": {
        "repo": "MasFana/pi-lsp",
        "commit": "ba3fa02c8e97f711abff506da3d49877d5d8b85d"
    },
    "declares": {
        "extensions": ["pi-lsp"],
        "tools": [
            "lsp_status",
            "lsp_diagnostics",
            "lsp_definition",
            "lsp_manage",
            "lsp_query",
            "fana_ast",
            "fana_graph",
            "fana_apply"
        ],
        "readOnlyTools": [
            "lsp_status",
            "lsp_diagnostics",
            "lsp_query",
            "fana_ast",
            "fana_graph"
        ],
        "hooks": ["afterTool"],
        "sections": ["lsp_workflow", "fana_routing"],
        "commands": [],
        "wraps": [],
        "routes": [
            "GET servers",
            "GET c/:conversation/servers",
            "POST c/:conversation/start",
            "POST c/:conversation/stop",
            "POST stop",
            "POST start",
            "POST install",
            "POST uninstall",
            "GET tooling/status",
            "GET c/:conversation/tooling/status",
            "POST tooling/prepare",
            "POST c/:conversation/tooling/prepare",
            "POST tooling/execute",
            "POST c/:conversation/tooling/execute"
        ],
        "client": "owner",
        "access": "owner"
    },

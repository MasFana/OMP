{
    "name": "pi-lsp",
    "title": "Pi Fana Tooling",
    "description": "Autonomous owner LSP/AST/CodeGraph workflow: preview/apply, provider management and automatic diagnostics without plugin confirmation prompts. Preserves native Pocket policies and 54 LSP definitions.",
    "tags": ["coding","lsp","ast","codegraph","refactoring","developer"],
    "author": {
        "name": "MasFana",
        "github": "MasFana"
    },
    "version": "1.3.1",
    "pocketApi": 2,
    "minPocket": "0.28.0",
    "source": {
        "repo": "MasFana/pi-lsp",
        "commit": "d3b7949950aa477b473ebfef4499d661c08b7d9b"
    },
    "declares": {
        "extensions": ["pi-lsp"],
        "tools": [
            "lsp_status",
            "lsp_diagnostics",
            "lsp_definition",
            "lsp_manage",
            "lsp_query",
            "fana_ast",
            "fana_graph",
            "fana_apply"
        ],
        "readOnlyTools": [
            "lsp_status",
            "lsp_diagnostics",
            "lsp_query",
            "fana_ast",
            "fana_graph"
        ],
        "hooks": ["afterTool"],
        "sections": ["lsp_workflow", "fana_routing"],
        "commands": [],
        "wraps": [],
        "routes": [
            "GET servers",
            "GET c/:conversation/servers",
            "POST c/:conversation/start",
            "POST c/:conversation/stop",
            "POST stop",
            "POST start",
            "POST install",
            "POST uninstall",
            "GET tooling/status",
            "GET c/:conversation/tooling/status",
            "POST tooling/execute",
            "POST c/:conversation/tooling/execute"
        ],
        "client": "owner",
        "access": "owner"
    },

                "tools": [
                    "lsp_status",
                    "lsp_diagnostics",
                    "lsp_definition",
                    "lsp_manage",
                    "lsp_query",
                    "fana_ast",
                    "fana_graph",
                    "fana_apply"
                ],
                "readOnlyTools": [
                    "lsp_status",
                    "lsp_diagnostics",
                    "lsp_query",
                    "fana_ast"
                ],
                "hooks": [
                    "afterTool"
                ],
                "sections": [
                    "lsp_workflow",
                    "fana_routing"
                ],
                "commands": [],
                "wraps": [],
                "routes": [
                    "GET servers",
                    "GET c/:conversation/servers",
                    "POST c/:conversation/start",
                    "POST c/:conversation/stop",
                    "POST stop",
                    "POST start",
                    "POST install",
                    "POST uninstall",
                    "GET tooling/status",
                    "GET c/:conversation/tooling/status",
                    "POST tooling/execute",
                    "POST c/:conversation/tooling/execute"
                ],
                "client": "owner",
                "access": "owner"

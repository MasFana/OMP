{
    "format": 1,
    "name": "OMP Pi Pocket Extensions",
    "repo": "https://github.com/MasFana/OMP",
    "extensions": [
        {
            "name": "pi-lsp",
            "title": "Pi LSP",
            "description": "Owner-gated LSP tools with 54 server definitions, lazy startup, automatic diagnostics after successful owner edit/write calls, prompt guidance and custom tool presentations. Owner dashboard and package management; no automatic installs.",
            "tags": [
                "coding",
                "lsp",
                "tools",
                "developer"
            ],
            "author": {
                "name": "MasFana",
                "github": "MasFana"
            },
            "version": "1.2.0",
            "pocketApi": 2,
            "minPocket": "0.28.0",
            "source": {
                "repo": "MasFana/pi-lsp",
                "commit": "0eb13080a9d0c879b3e23120db3bbf59f5b6ca88"
            },
            "declares": {
                "extensions": [
                    "pi-lsp"
                ],
                "tools": [
                    "lsp_status",
                    "lsp_diagnostics",
                    "lsp_definition",
                    "lsp_manage"
                ],
                "readOnlyTools": [
                    "lsp_status",
                    "lsp_diagnostics"
                ],
                "hooks": [
                    "afterTool"
                ],
                "sections": [
                    "lsp_workflow"
                ],
                "commands": [],
                "wraps": [],
                "routes": [
                    "GET servers",
                    "GET c/:conversation/servers",
                    "POST c/:conversation/start",
                    "POST c/:conversation/stop",
                    "POST stop",
                    "POST start",
                    "POST install",
                    "POST uninstall"
                ],
                "client": "owner",
                "access": "owner"
            },
            "files": [
                {
                    "name": "pi-lsp.ts",
                    "sha256": "d4a7ef9246e3b431c18fc154de3d9a68da9ca04e070a265cf4cc75dd73535652",
                    "size": 67799
                },
                {
                    "name": "pi-lsp.js",
                    "sha256": "eccb0d8683c060f9c3b433eec06d79306c2c09024ffa45b7834ae74813ddeaca",
                    "size": 20902
                }
            ]
        }
    ]
}

{
    "format": 1,
    "name": "OMP Pi Pocket Extensions",
    "repo": "https://github.com/MasFana/OMP",
    "extensions": [
        {
            "name": "pi-lsp",
            "title": "Pi Fana Tooling",
            "description": "55-server LSP catalog, verified installer outcomes, automatic AST detection and source-change CodeGraph sync. Owner handoff without extension prompts; native Pocket policies retained.",
            "tags": [
                "coding",
                "lsp",
                "ast",
                "codegraph",
                "refactoring",
                "developer"
            ],
            "author": {
                "name": "MasFana",
                "github": "MasFana"
            },
            "version": "1.3.2",
            "pocketApi": 2,
            "minPocket": "0.28.0",
            "source": {
                "repo": "MasFana/pi-lsp",
                "commit": "f38f790e57b0357390555cf102ac3a4fbbc13ef0"
            },
            "declares": {
                "extensions": [
                    "pi-lsp"
                ],
                "tools": [
                    "lsp_status",
                    "lsp_diagnostics",
                    "lsp_definition",
                    "lsp_manage",
                    "lsp_query",
                    "fana_ast",
                    "fana_graph",
                    "fana_apply"
                ],
                "readOnlyTools": [
                    "lsp_status",
                    "lsp_diagnostics",
                    "lsp_query",
                    "fana_ast"
                ],
                "hooks": [
                    "afterTool"
                ],
                "sections": [
                    "lsp_workflow",
                    "fana_routing"
                ],
                "commands": [],
                "wraps": [],
                "routes": [
                    "GET servers",
                    "GET c/:conversation/servers",
                    "POST c/:conversation/start",
                    "POST c/:conversation/stop",
                    "POST stop",
                    "POST start",
                    "POST install",
                    "POST uninstall",
                    "GET tooling/status",
                    "GET c/:conversation/tooling/status",
                    "POST tooling/execute",
                    "POST c/:conversation/tooling/execute"
                ],
                "client": "owner",
                "access": "owner"
            },
